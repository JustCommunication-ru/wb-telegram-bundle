{
    "name": "justcommunication-ru/wb-telegram-bundle",
    "description": "Telegram bundle",
    "type": "symfony-bundle",
    "keywords": ["telegram","messages","notification"],
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "justcommunication-ru/wb-cache-bundle": "^0.1",
        "justcommunication-ru/wb-func-bundle": "^0.1",

        "symfony/http-kernel": ">=5.4 ^7.4",
        "symfony/config": ">=5.4 ^7.4",
        "symfony/dependency-injection": ">=5.4 ^7.4",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^3.3",
        "symfony/framework-bundle": ">=5.4 ^7.4",
        "symfony/yaml": ">=5.4 ^7.4"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/JustCommunication-ru/wb-cache-bundle.git"
        },
        {
            "type": "git",
            "url": "https://github.com/JustCommunication-ru/wb-func-bundle.git"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "JustCommunication\\TelegramBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustCommunication\\TelegramBundle\\Tests\\": "tests/"
        }
    },

    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },

    "require-dev": {
        "symfony/browser-kit": "^7.4",
        "symfony/phpunit-bridge": "^7.4"
    }
}
